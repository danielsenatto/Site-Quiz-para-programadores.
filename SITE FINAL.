<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DevQuiz | Desafio para Programadores</title>

    <meta name="description"
        content="Teste seus conhecimentos sobre programação com o DevQuiz.">

    <style>

        /* =========================
           CONFIGURAÇÕES GERAIS
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --azul: #38bdf8;
            --roxo: #8b5cf6;
            --verde: #22c55e;
            --fundo: #070b18;
            --card: rgba(20, 28, 50, 0.75);
            --texto: #f8fafc;
            --texto-secundario: #94a3b8;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--texto);
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #172554, transparent 40%),
                radial-gradient(circle at bottom right, #3b0764, transparent 40%),
                var(--fundo);

            overflow-x: hidden;
        }


        /* =========================
           FUNDO DECORATIVO
        ========================== */

        body::before,
        body::after {
            content: "";
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.25;
            z-index: -1;
        }

        body::before {
            background: #2563eb;
            top: -150px;
            left: -100px;
        }

        body::after {
            background: #7c3aed;
            bottom: -150px;
            right: -100px;
        }


        /* =========================
           HEADER
        ========================== */

        header {
            min-height: 350px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;

            background:
                linear-gradient(
                    rgba(7, 11, 24, 0.3),
                    rgba(7, 11, 24, 0.9)
                );
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            padding: 8px 18px;
            margin-bottom: 20px;

            border: 1px solid rgba(56, 189, 248, 0.4);
            border-radius: 50px;

            color: var(--azul);

            background: rgba(56, 189, 248, 0.08);

            font-size: 14px;
        }

        header h1 {
            font-size: clamp(42px, 7vw, 75px);
            max-width: 900px;
            line-height: 1.1;

            background: linear-gradient(
                90deg,
                #ffffff,
                #38bdf8,
                #a78bfa
            );

            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        header p {
            max-width: 650px;
            margin-top: 25px;

            font-size: 19px;
            line-height: 1.6;

            color: var(--texto-secundario);
        }


        /* =========================
           PROGRESSO
        ========================== */

        .progress-container {
            width: min(900px, 90%);
            margin: 20px auto 40px;
        }

        .progress-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;

            color: var(--texto-secundario);
            font-size: 14px;
        }

        .progress-bar {
            height: 10px;
            background: #1e293b;
            border-radius: 50px;
            overflow: hidden;
        }

        .progress {
            width: 20%;
            height: 100%;

            background:
                linear-gradient(
                    90deg,
                    var(--azul),
                    var(--roxo)
                );

            border-radius: 50px;

            box-shadow:
                0 0 20px rgba(56, 189, 248, 0.8);
        }


        /* =========================
           CONTEÚDO
        ========================== */

        main {
            width: min(900px, 92%);
            margin: auto;
            padding-bottom: 80px;
        }


        /* =========================
           CARDS
        ========================== */

        .quiz-card {
            position: relative;

            padding: 35px;
            margin-bottom: 25px;

            border-radius: 24px;

            background: var(--card);

            border:
                1px solid
                rgba(255, 255, 255, 0.08);

            backdrop-filter: blur(15px);

            box-shadow:
                0 20px 50px
                rgba(0, 0, 0, 0.3);

            transition:
                transform 0.3s ease,
                border 0.3s ease;
        }

        .quiz-card:hover {
            transform: translateY(-5px);

            border-color:
                rgba(56, 189, 248, 0.4);
        }

        .question-number {
            display: flex;

            width: 45px;
            height: 45px;

            justify-content: center;
            align-items: center;

            margin-bottom: 20px;

            border-radius: 14px;

            font-weight: bold;

            background:
                linear-gradient(
                    135deg,
                    var(--azul),
                    var(--roxo)
                );

            box-shadow:
                0 10px 30px
                rgba(56, 189, 248, 0.25);
        }

        .quiz-card h2 {
            font-size: 22px;
            line-height: 1.4;
            margin-bottom: 25px;
        }


        /* =========================
           INTRODUÇÃO
        ========================== */

        .intro h2 {
            color: var(--azul);
        }

        .intro p {
            color: var(--texto-secundario);
            line-height: 1.7;
            margin-top: 12px;
        }


        /* =========================
           ALTERNATIVAS
        ========================== */

        .options {
            display: grid;
            gap: 12px;
        }

        .option {
            display: flex;
            align-items: center;

            padding: 16px 20px;

            border-radius: 14px;

            cursor: pointer;

            background:
                rgba(255, 255, 255, 0.04);

            border:
                1px solid
                rgba(255, 255, 255, 0.08);

            transition: 0.25s;
        }

        .option:hover {
            background:
                rgba(56, 189, 248, 0.08);

            border-color:
                rgba(56, 189, 248, 0.5);

            transform: translateX(5px);
        }

        .option input {
            margin-right: 12px;
            accent-color: var(--azul);
        }


        /* =========================
           INPUTS
        ========================== */

        input[type="text"],
        input[type="password"],
        input[type="number"] {
            width: 100%;

            padding: 17px 18px;

            border-radius: 14px;

            border:
                1px solid
                rgba(255, 255, 255, 0.1);

            background:
                rgba(0, 0, 0, 0.2);

            color: white;

            font-size: 16px;

            transition: 0.3s;
        }

        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="number"]:focus {
            outline: none;

            border-color:
                var(--azul);

            box-shadow:
                0 0 0 4px
                rgba(56, 189, 248, 0.1);
        }


        /* =========================
           UPLOAD
        ========================== */

        input[type="file"] {
            width: 100%;
            padding: 15px;

            border-radius: 14px;

            border:
                2px dashed
                rgba(56, 189, 248, 0.4);

            background:
                rgba(56, 189, 248, 0.04);

            color:
                var(--texto-secundario);
        }


        /* =========================
           IMAGEM
        ========================== */

        .language-image {
            display: block;

            width: 160px;
            max-width: 100%;

            margin: 20px 0;

            padding: 20px;

            border-radius: 20px;

            background: white;

            box-shadow:
                0 15px 40px
                rgba(0, 0, 0, 0.3);
        }


        /* =========================
           TABELA
        ========================== */

        .score-table {
            width: 100%;
            border-collapse: collapse;

            overflow: hidden;

            border-radius: 15px;
        }

        .score-table th {
            padding: 17px;

            background:
                rgba(56, 189, 248, 0.15);

            color: var(--azul);

            text-align: left;
        }

        .score-table td {
            padding: 17px;

            color:
                var(--texto-secundario);

            border-top:
                1px solid
                rgba(255, 255, 255, 0.07);
        }


        /* =========================
           BOTÃO
        ========================== */

        .finish-button {
            width: 100%;

            padding: 20px;

            margin-top: 20px;

            border: none;
            border-radius: 18px;

            cursor: pointer;

            color: white;

            font-size: 18px;
            font-weight: bold;

            background:
                linear-gradient(
                    90deg,
                    #0ea5e9,
                    #6366f1,
                    #8b5cf6
                );

            background-size: 200%;

            transition: 0.3s;

            box-shadow:
                0 15px 40px
                rgba(99, 102, 241, 0.35);
        }

        .finish-button:hover {
            transform: translateY(-4px);

            background-position: right;
        }


        /* =========================
           FOOTER
        ========================== */

        footer {
            text-align: center;

            padding: 35px 20px;

            border-top:
                1px solid
                rgba(255, 255, 255, 0.06);

            color:
                var(--texto-secundario);
        }


        /* =========================
           RESPONSIVO
        ========================== */

        @media (max-width: 600px) {

            header {
                min-height: 280px;
            }

            .quiz-card {
                padding: 25px 20px;
            }

            .quiz-card h2 {
                font-size: 19px;
            }

        }

    </style>

</head>


<body>


    <!-- HEADER -->

    <header>

        <div class="badge">
            🚀 DESAFIO PARA DESENVOLVEDORES
        </div>

        <h1>
            Quanto você sabe sobre programação?
        </h1>

        <p>
            Teste seus conhecimentos, responda às perguntas
            e descubra o seu nível no mundo da programação.
        </p>

    </header>


    <!-- BARRA DE PROGRESSO -->

    <div class="progress-container">

        <div class="progress-info">

            <span>Seu progresso</span>

            <span>1 de 6 perguntas</span>

        </div>

        <div class="progress-bar">

            <div class="progress"></div>

        </div>

    </div>


    <main>


        <!-- INTRODUÇÃO -->

        <section class="quiz-card intro">

            <h2>👋 Bem-vindo ao DevQuiz!</h2>

            <p>
                Este desafio foi criado para testar seus conhecimentos
                sobre programação, tecnologia e desenvolvimento web.
            </p>

            <p>
                Você encontrará perguntas de múltipla escolha,
                respostas em texto e desafios interativos.
            </p>

            <p>
                Boa sorte! 🚀
            </p>

        </section>


        <!-- PERGUNTA 1 -->

        <section class="quiz-card">

            <div class="question-number">
                01
            </div>

            <h2>
                Qual linguagem é utilizada para estruturar
                páginas da web?
            </h2>

            <div class="options">

                <label class="option">

                    <input
                        type="radio"
                        name="pergunta1"
                        value="Python"
                    >

                    Python

                </label>


                <label class="option">

                    <input
                        type="radio"
                        name="pergunta1"
                        value="HTML"
                    >

                    HTML

                </label>


                <label class="option">

                    <input
                        type="radio"
                        name="pergunta1"
                        value="JavaScript"
                    >

                    JavaScript

                </label>


                <label class="option">

                    <input
                        type="radio"
                        name="pergunta1"
                        value="Portugol"
                    >

                    Portugol

                </label>

            </div>

        </section>


        <!-- PERGUNTA 2 -->

        <section class="quiz-card">

            <div class="question-number">
                02
            </div>

            <h2>
                Na URL https://www.google.com,
                o trecho "google.com" é chamado de quê?
            </h2>

            <input
                type="text"
                name="pergunta2"
                placeholder="Digite sua resposta..."
            >

        </section>


        <!-- PERGUNTA 3 -->

        <section class="quiz-card">

            <div class="question-number">
                03
            </div>

            <h2>
                Crie um exemplo de senha forte:
            </h2>

            <input
                type="password"
                name="pergunta3"
                placeholder="Digite uma senha segura..."
            >

        </section>


        <!-- PERGUNTA 4 -->

        <section class="quiz-card">

            <div class="question-number">
                04
            </div>

            <h2>
                Em que ano foi lançada a primeira versão do HTML?
            </h2>

            <input
                type="number"
                name="pergunta4"
                placeholder="Digite o ano..."
            >

        </section>


        <!-- PERGUNTA 5 -->

        <section class="quiz-card">

            <div class="question-number">
                05
            </div>

            <h2>
                Envie um arquivo HTML:
            </h2>

            <input
                type="file"
                name="pergunta5"
                accept=".html,.htm"
            >

        </section>


        <!-- PERGUNTA 6 -->

        <section class="quiz-card">

            <div class="question-number">
                06
            </div>

            <h2>
                Qual linguagem é representada pelo logo de uma xícara de café?
            </h2>

            <input
                type="text"
                name="pergunta6"
                placeholder="Digite o nome da linguagem..."
            >

        </section>


        <!-- PONTUAÇÃO -->

        <section class="quiz-card">

            <h2>
                🏆 Sistema de Pontuação
            </h2>

            <table class="score-table">

                <thead>

                    <tr>

                        <th>
                            Pontuação
                        </th>

                        <th>
                            Resultado
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <tr>

                        <td>
                            0 - 5 pontos
                        </td>

                        <td>
                            Continue estudando! A prática leva à evolução.
                        </td>

                    </tr>


                    <tr>

                        <td>
                            6 - 10 pontos
                        </td>

                        <td>
                            Excelente! Você tem ótimos conhecimentos em programação!
                        </td>

                    </tr>

                </tbody>

            </table>

        </section>


        <!-- BOTÃO -->

        <button class="finish-button">

            FINALIZAR DESAFIO 🚀

        </button>


    </main>


    <!-- FOOTER -->

    <footer>

        💻 DevQuiz • Desenvolvido para apaixonados por tecnologia

    </footer>


</body>

</html>
